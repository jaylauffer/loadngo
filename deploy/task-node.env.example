# Example configuration for loadngo-task-node.service.
#
# Copy to /etc/loadngo/task-node.env and edit. That path is referenced by
# the unit's EnvironmentFile= and is deliberately outside this repo, so
# real deployment values are never committed.
#
# Network addresses below use the RFC 5737 documentation ranges
# (192.0.2.0/24, 198.51.100.0/24). Replace them with your own; they are
# not reachable anywhere.

# The built worker binary and the directory it runs from.
LOADNGO_TASK_NODE_BINARY=/home/jay/pudding/loadngo/target/release/task-node
LOADNGO_TASK_NODE_WORKDIR=/home/jay/pudding/loadngo

# Identifies this worker in TaskOffer/TaskResult messages. Must be unique
# within the fabric; a hostname-derived value is the usual choice.
LOADNGO_TASK_NODE_ID=example-task-node

# Where submitters can reach this node directly, once discovery is done.
# Two entries here because this node is on two segments (wired and wifi)
# and should be reachable on both.
LOADNGO_TASK_NODE_REPLY_ENDPOINTS="192.0.2.10:9850 198.51.100.10:9850"

# Discovery groups. These are a site convention, not a protocol constant:
# every submitter and worker in one fabric must agree on them. The
# `%2`/`%3` suffixes are IPv6 scope ids (interface indexes), and the
# `@address` suffix selects the outgoing interface for IPv4.
LOADNGO_TASK_NODE_MULTICAST_V6="ff02::4541:544b:1%2 ff02::4541:544b:1%3"
LOADNGO_TASK_NODE_MULTICAST_V4="239.42.84.1@192.0.2.10 239.42.84.1@198.51.100.10"

# What this node advertises it can do. A TaskRequest naming a capability
# this node lacks is ignored rather than offered on.
LOADNGO_TASK_NODE_CAPABILITIES="qcoin-receipt loadngo-task repo-tip"

LOADNGO_TASK_NODE_BIND_PORT=9850
LOADNGO_TASK_NODE_ARTIFACT_HINT=/var/lib/loadngo-task-node/receipts

LOADNGO_TASK_NODE_NOTE=standing dual-network worker for bounded receipts and diagnostics
LOADNGO_TASK_NODE_RESULT_NOTE=task-node receipt generated under /var/lib/loadngo-task-node/receipts

LOADNGO_TASK_NODE_ESTIMATED_DURATION_SECONDS=60
LOADNGO_TASK_NODE_MAX_STATUS_INTERVAL_SECONDS=15
LOADNGO_TASK_NODE_ACK_TIMEOUT_SECONDS=180
LOADNGO_TASK_NODE_IDLE_INTERVAL_MILLIS=250

# THE SECURITY BOUNDARY. This command runs on every accepted assignment,
# with task-supplied values in its environment, and the fabric does not
# authenticate submitters -- see README.md in this directory before
# changing it to anything less constrained than the shipped script.
LOADNGO_TASK_NODE_EXEC_COMMAND=/usr/local/bin/loadngo-task-node-exec.sh
